# Spring / application
APP_SPRING_PROFILES_ACTIVE=local
SERVER_PORT=9900
APP_PORT=9900
MANAGEMENT_SERVER_PORT=9911
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_CHAT_MODEL=qwen3.7-flash
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_COMPLETIONS_PATH=/chat/completions
DASHSCOPE_CHAT_ENABLE_THINKING=false
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=superbiz_agent
POSTGRES_USER=superbiz
POSTGRES_PASSWORD=superbiz_local_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=

# RustFS / S3-compatible object storage
RUSTFS_ENDPOINT=http://localhost:19000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=superbiz-agent
RUSTFS_REGION=us-east-1
RUSTFS_AUTO_CREATE_BUCKET=true

# Current AIOps external integrations
MCP_CLIENT_ENABLED=false
MCP_CLIENT_NAME=tencent-cls
MCP_CLIENT_VERSION=1.0.0
MCP_CLIENT_REQUEST_TIMEOUT=60s
MCP_CLIENT_TYPE=ASYNC
CLS_MCP_URL=http://localhost:13000
CLS_MCP_SSE_ENDPOINT=/sse
PROMETHEUS_BASE_URL=http://localhost:19090
PROMETHEUS_MOCK_ENABLED=true
CLS_MOCK_ENABLED=true
# Authentication is always enabled. Set these in the current shell or secret
# manager; the first administrator must change the initial password.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_INITIAL_PASSWORD=
AUTH_SESSION_TIMEOUT_MINUTES=720
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15
AUTH_SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:9900,http://127.0.0.1:9900
CLS_MCP_PORT=13000
CLS_MCP_MAX_LENGTH=15000
TENCENTCLOUD_REGION=ap-guangzhou

# Optional docker compose --profile mcp service. Use real values only in the
# current shell or your deployment secret manager; do not commit them.
TENCENTCLOUD_SECRET_ID=replace-with-your-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-your-secret-key
TENCENTCLOUD_API_BASE_HOST=tencentcloudapi.com

# Tencent CLS log upload. These credentials must be the writer sub-account,
# separate from the reader credentials used by cls-mcp-server.
CLS_UPLOAD_ENABLED=false
CLS_UPLOAD_ENDPOINT=
CLS_WRITER_SECRET_ID=replace-with-your-writer-secret-id
CLS_WRITER_SECRET_KEY=replace-with-your-writer-secret-key
CLS_SERVICE_NAME=soarer-alert-agent
CLS_ENVIRONMENT=local
CLS_HOST_NAME=
CLS_SERVICE_IP=
CLS_APP_TOPIC_ID=d4fd734b-0451-4567-92a7-e3bd68d9c5d8
CLS_HOST_TOPIC_ID=d2a46e90-7a30-447e-bf5c-a9113e18ab88
CLS_MIDDLEWARE_TOPIC_ID=2708c9fa-9d93-4f94-9508-659108eb70c7
CLS_DIAGNOSIS_TOPIC_ID=e574cb90-10ba-445e-8467-cc99f563ca11

# Observability
PROMETHEUS_PORT=19090
PROMETHEUS_RETENTION=15d
LOKI_PORT=13100
